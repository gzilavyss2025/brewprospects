---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import StatTable from '../../components/StatTable.astro'
import Headshot from '../../components/Headshot.astro'
import { org, affiliateById, mlbFor, gamelogFor } from '../../lib/build/data.js'
import { playerPages, ranksFor, lastArchiveStop, seasonByYear } from '../../lib/build/archive.js'
import { levelPath, statRows, primaryGroup, statusGroup } from '../../lib/model/org.js'
import { levelFor } from '../../lib/model/levels.js'
import { mlbRows } from '../../lib/model/mlb.js'
import { throughText } from '../../lib/model/player/gamelog-view.js'
import { playerSlug, idFromSlug, canonicalUrl, paths } from '../../lib/slug.js'
import { personLd } from '../../lib/jsonld.js'
import { heightWeight, batsThrows, orDash } from '../../lib/format.js'
import { ARCHIVE_FIRST_SEASON } from '../../config/site.js'
import { allPosts, playerNotes, postUrl } from '../../lib/build/content.js'
import { postsForPlayer } from '../../lib/model/posts.js'

export async function getStaticPaths() {
  return playerPages().map((p) => ({ params: { slug: playerSlug(p.name, p.id) }, props: { player: p } }))
}

const { player } = Astro.props
const club = player.assignment ? affiliateById.get(player.assignment.teamId) : null
const level = club ? levelFor(club.sportId) : null
const group = primaryGroup(player)
const other = group === 'hitting' ? 'pitching' : 'hitting'
const primaryRows = statRows(player, group)
const otherRows = statRows(player, other)
const path = levelPath(player)
const mlbEntry = mlbFor(player.id)
const mlbPrimary = mlbRows(mlbEntry, group)
const mlbOther = mlbRows(mlbEntry, other)
const log = gamelogFor(player.id)
const logGroups = [group, other]
  .map((g) => ({ g, rows: log?.[g] ?? [] }))
  .filter(({ rows }) => rows.length > 0)
const lastStop = player.archiveOnly ? lastArchiveStop(player.id) : null
const lastClub = lastStop
  ? seasonByYear.get(lastStop.season)?.affiliates.find((a) => a.id === lastStop.teamId)?.name
  : null
const ranks = ranksFor(player.id)
const where = (() => {
  if (player.archiveOnly) return lastClub ? `Last on a Brewers farm club: ${lastClub}, ${lastStop.season}` : 'Former Brewers farmhand'
  const g = player.assignment ? statusGroup(player.assignment.status) : null
  if (!club) return 'Not on a Brewers affiliate roster'
  if (g === 'gone') return `Left the org (last with ${club.name})`
  if (g === 'injured') return `${club.name} · injured list`
  return club.name
})()

const note = (await playerNotes()).find((n) => idFromSlug(n.id) === player.id) ?? null
const { Content: NoteContent } = note ? await render(note) : { Content: null }
const posts = postsForPlayer(await allPosts(), player.id)
const draft = player.draft
const draftText = draft
  ? [draft.year, draft.round && `round ${draft.round}`, draft.pick && `pick ${draft.pick}`, draft.team && `by ${draft.team}`]
      .filter(Boolean)
      .join(', ')
  : null
---
<Base
  title={player.name}
  description={`${player.name}: ${player.pos || 'player'}, ${where}. Level path and MiLB stats.`}
  jsonLd={personLd({ name: player.name, url: canonicalUrl(Astro.site, paths.player(player.name, player.id)), jobTitle: player.pos })}
>
  <div class="player-head">
    <Headshot player={player} />
    <div>
      {level && <span class="pennant">{level.label}</span>}
      <h1>{player.name}</h1>
      <p><strong>{orDash(player.pos)}</strong> · {where}</p>
      {player.rank && (
        <p>
          <span class="rank">MLB Pipeline Brewers #{player.rank.orgRank}</span>
          {player.rank.topRank && <> <span class="rank">Top 100 #{player.rank.topRank}</span></>}
        </p>
      )}
      <dl class="facts">
        <dt>B/T</dt><dd>{batsThrows(player.bats, player.throws)}</dd>
        <dt>Size</dt><dd>{heightWeight(player.height, player.weight)}</dd>
        <dt>Born</dt><dd>{orDash(player.birthDate)}{player.birthPlace ? ` · ${player.birthPlace}` : ''}</dd>
        <dt>Acquired</dt><dd>{draftText ? `Drafted ${draftText}` : '—'}</dd>
        {player.mlbDebutDate && <><dt>MLB debut</dt><dd>{player.mlbDebutDate}</dd></>}
      </dl>
    </div>
  </div>

  {note && (
    <section class="section">
      <h2>Notes</h2>
      <div class="player-note prose"><NoteContent /></div>
    </section>
  )}

  {ranks.length > 0 && (
    <section class="section">
      <h2>Top 100 history</h2>
      <p>
        {ranks.map((r) => <><span class="rank" title={r.source === 'baseball-america' ? 'Baseball America' : 'MLB Pipeline'}>{r.season} #{r.rank}</span>{' '}</>)}
      </p>
      <p class="muted">Preseason Top 100 ranks from years he played in the Brewers system. <a href="/prospects">All years</a></p>
    </section>
  )}

  {player.archiveOnly && (
    player.careerThrough ? (
      <p class="coverage section">The path and tables below cover his minor-league seasons with any club, as the MLB Stats API lists them, through {player.careerThrough}. His major-league seasons are in the "Major leagues" section.</p>
    ) : (
      <p class="coverage section">The path and tables below cover only his minor-league seasons with Brewers affiliates, {ARCHIVE_FIRST_SEASON} on. Time with other clubs is not on record here. His major-league seasons, with any club, are in the "Major leagues" section.</p>
    )
  )}

  <section class="section">
    <h2>Level path</h2>
    {path.length === 0 ? (
      <p class="muted">No MiLB games on record.</p>
    ) : (
      <ol class="path">
        {path.map((s) => (
          <li>
            <span class="pennant">{s.label}</span>
            <span class="num">{s.season}</span>
            <span class="muted">{s.team}</span>
          </li>
        ))}
      </ol>
    )}
  </section>

  <section class="section">
    <h2>{group === 'hitting' ? 'Hitting' : 'Pitching'}</h2>
    {primaryRows.length ? <StatTable rows={primaryRows} group={group} /> : <p class="muted">No {group} stats on record.</p>}
  </section>
  {otherRows.length > 0 && (
    <section class="section">
      <h2>{other === 'hitting' ? 'Hitting' : 'Pitching'}</h2>
      <StatTable rows={otherRows} group={other} />
    </section>
  )}

  {logGroups.length > 0 && (
    <section class="section">
      <h2>Game log</h2>
      {logGroups.map(({ g, rows }) => (
        <>
          <h3>{g === 'hitting' ? 'Hitting' : 'Pitching'}</h3>
          <StatTable rows={rows} group={g} gamelog />
        </>
      ))}
      <p class="muted">
        A row is one game he played, newest first. A game he did not play has no row, so a log can have fewer rows
        than the G column above for the same season: a pitcher who batted once shows one hitting row. Season {log.season}, through {throughText(log.season, logGroups.flatMap(({ rows }) => rows))}.
      </p>
    </section>
  )}

  <section class="section">
    <h2>Major leagues</h2>
    {mlbPrimary.length + mlbOther.length === 0 ? (
      <p class="muted">No major-league games on record.</p>
    ) : (
      [[group, mlbPrimary], [other, mlbOther]].filter(([, rows]) => rows.length > 0).map(([g, rows]) => (
        <>
          <h3>{g === 'hitting' ? 'Hitting' : 'Pitching'}</h3>
          <StatTable rows={rows} group={g} major />
        </>
      ))
    )}
  </section>

  <section class="section">
    <h2>Posts about him</h2>
    {posts.length === 0 ? (
      <p class="muted">None yet.</p>
    ) : (
      <ul>
        {posts.map((p) => <li><a href={postUrl(p)}>{p.data.title}</a> <span class="muted">· {p.type.label}</span></li>)}
      </ul>
    )}
  </section>

  <p class="muted section">
    Stats from the MLB Stats API, through {new Date(org.generatedAt).toLocaleDateString('en-US', { dateStyle: 'medium' })}.
  </p>
</Base>
