---
import Base from '../../layouts/Base.astro'
import { org, allPlayers, affiliates, playerUrl } from '../../lib/build/data.js'
import { levelFor } from '../../lib/levels.js'

// Grouped by where each player is now; players who left the org come last.
const players = allPlayers()
const groups = affiliates.map((a) => ({
  club: a,
  level: levelFor(a.sportId),
  players: players
    .filter((p) => p.assignment?.teamId === a.id && p.assignment.group !== 'gone')
    .sort((x, y) => (x.rank?.orgRank ?? 999) - (y.rank?.orgRank ?? 999) || x.name.localeCompare(y.name)),
}))
const gone = players.filter((p) => p.assignment?.group === 'gone').sort((x, y) => x.name.localeCompare(y.name))
---
<Base title="Players" description={`All ${players.length} players in the Brewers farm system in ${org.season}.`}>
  <h1>Every player in the org</h1>
  <p class="muted">{players.length} players on a Brewers affiliate roster in {org.season}. Ranked prospects first.</p>
  {groups.map((g) => (
    <section class="section">
      <h2><span class="pennant">{g.level?.label}</span> {g.club.name}</h2>
      <p class="muted">{g.players.length} players</p>
      <div class="grid">
        {g.players.map((p) => (
          <a class="card" href={playerUrl(p)}>
            <strong>{p.name}</strong> <span class="muted">{p.pos}</span>
            {p.rank && <> <span class="rank">#{p.rank.orgRank}</span></>}
            {p.assignment?.group === 'injured' && <div class="muted">Injured list</div>}
          </a>
        ))}
      </div>
    </section>
  ))}
  {gone.length > 0 && (
    <section class="section">
      <h2>Left the org in {org.season}</h2>
      <p>
        {gone.map((p, i) => <>{i > 0 && ' · '}<a href={playerUrl(p)}>{p.name}</a></>)}
      </p>
    </section>
  )}
</Base>
