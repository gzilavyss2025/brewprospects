---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/components.css'
import { SITE_NAME, SITE_TAGLINE, DISCLAIMER, ORG_ID } from '../config/site.js'
import { teamLogoUrl } from '../lib/affiliates.js'
import { canonicalUrl } from '../lib/slug.js'

const { title, description = SITE_TAGLINE } = Astro.props
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME
const path = Astro.url.pathname
const canonical = canonicalUrl(Astro.site, path)
const nav = [
  { href: '/', label: 'Home' },
  { href: '/depth-chart', label: 'Depth chart' },
  { href: '/players', label: 'Players' },
  { href: '/seasons', label: 'Seasons' },
  { href: '/prospects', label: 'Top 100' },
  { href: '/posts', label: 'Posts' },
]
const current = (href) => (href === '/' ? path === '/' : path.startsWith(href))
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href={teamLogoUrl(ORG_ID)} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow:wght@400;600;700;800&family=Barlow+Condensed:wght@500;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src={teamLogoUrl(ORG_ID)} alt="" width="44" height="44" />
          <span>{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{DISCLAIMER}</p>
      </div>
    </footer>
  </body>
</html>
