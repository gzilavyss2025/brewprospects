---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/components.css'
import { SITE_NAME, SITE_TAGLINE, DISCLAIMER, ORG_ID } from '../config/site.js'
import { teamLogoUrl } from '../lib/identity/affiliates.js'
import { paths } from '../lib/slug.js'
import { headMeta } from '../lib/seo.js'
import { jsonLdScript } from '../lib/jsonld.js'
import { THEME_BOOT } from '../lib/theme.js'

const { title, description = SITE_TAGLINE, type = 'website', jsonLd } = Astro.props
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME
const path = Astro.url.pathname
const head = headMeta({ site: Astro.site, path, title: fullTitle, description, type })
const jsonLdBlocks = [jsonLd].flat().filter(Boolean)
const nav = [
  { href: '/', label: 'Home' },
  { href: '/depth-chart', label: 'Depth chart' },
  { href: '/players', label: 'Players' },
  { href: '/seasons', label: 'Seasons' },
  { href: '/prospects', label: 'Top 100' },
  { href: '/posts', label: 'Posts' },
]
const current = (href) => (href === '/' ? path === '/' : path.startsWith(href))
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={THEME_BOOT} />
    <title>{fullTitle}</title>
    {head.meta.map((m) => <meta {...m} />)}
    {head.links.map((l) => <link {...l} />)}
    {jsonLdBlocks.map((block) => <script type="application/ld+json" set:html={jsonLdScript(block)} />)}
    <link rel="icon" href={teamLogoUrl(ORG_ID)} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={paths.feed()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow:wght@400;600;700;800&family=Barlow+Condensed:wght@500;700&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src={teamLogoUrl(ORG_ID)} alt="" width="44" height="44" />
          <span>{SITE_NAME}</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="theme-toggle" type="button" aria-pressed="false" hidden>Dark mode</button>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>{DISCLAIMER} <a href="/about">About and credits</a></p>
      </div>
    </footer>
    <script>
      // The toggle needs JavaScript, so it stays hidden until this runs.
      import { THEME_KEY, nextTheme } from '../lib/theme.js'
      const root = document.documentElement
      const button = document.querySelector('.theme-toggle')
      const show = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'))
      button.addEventListener('click', () => {
        root.dataset.theme = nextTheme(root.dataset.theme)
        try { localStorage.setItem(THEME_KEY, root.dataset.theme) } catch { /* the choice lasts this page only */ }
        show()
      })
      show()
      button.hidden = false
    </script>
  </body>
</html>
