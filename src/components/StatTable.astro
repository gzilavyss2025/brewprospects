---
// One player's year-by-year table for one stat group. A missing value shows a
// dash. The rows arrive with their rates already computed from the counts
// (src/lib/model/player/rates.js); the table computes nothing. `major` is the
// big-league table: it has no level column, since every row is MLB. `gamelog`
// is the game log: rows are one per game, and the leading columns and the stat
// columns come from src/lib/model/player/gamelog-view.js.
import { levelFor } from '../lib/model/levels.js'
import { orDash } from '../lib/format.js'
import { gameLogRows, gameLogHead } from '../lib/model/player/gamelog-view.js'

const { rows, group, major = false, gamelog = false } = Astro.props
const logHead = gamelog ? gameLogHead(group) : []
const logRows = gamelog ? gameLogRows(group, rows) : []
const COLS = {
  hitting: [
    ['g', 'G'], ['pa', 'PA'], ['h', 'H'], ['d', '2B'], ['t', '3B'], ['hr', 'HR'], ['r', 'R'], ['rbi', 'RBI'],
    ['bb', 'BB'], ['so', 'SO'], ['sb', 'SB'], ['avg', 'AVG'], ['obp', 'OBP'], ['slg', 'SLG'], ['ops', 'OPS'],
    ['iso', 'ISO'], ['kPct', 'K%'], ['bbPct', 'BB%'], ['babip', 'BABIP'],
  ],
  pitching: [
    ['g', 'G'], ['gs', 'GS'], ['w', 'W'], ['l', 'L'], ['sv', 'SV'], ['ip', 'IP'], ['h', 'H'], ['bb', 'BB'],
    ['so', 'SO'], ['hr', 'HR'], ['era', 'ERA'], ['whip', 'WHIP'], ['k9', 'K/9'], ['bb9', 'BB/9'],
    ['kPct', 'K%'], ['bbPct', 'BB%'], ['kbbPct', 'K-BB%'],
  ],
}[group]
---
<div class="table-scroll" tabindex="0" role="region" aria-label={gamelog ? `${group === 'hitting' ? 'Hitting' : 'Pitching'} game log` : major ? `Major-league ${group} stats by year` : `${group === 'hitting' ? 'Hitting' : 'Pitching'} stats by year`}>
  <table class={gamelog ? 'stats game-log' : 'stats'}>
    <thead>
      <tr>
        {gamelog ? logHead.map((label) => <th scope="col">{label}</th>) : <>
        <th scope="col">Year</th>
        {!major && <th scope="col">Lvl</th>}
        <th scope="col">Club</th>
        <th scope="col">Age</th>
        {COLS.map(([, label]) => <th scope="col">{label}</th>)}
        </>}
      </tr>
    </thead>
    <tbody>
      {gamelog ? logRows.map((r) => (
        <tr>{r.cells.map((c) => <td>{c}</td>)}</tr>
      )) : rows.map((r) => (
        <tr>
          <td>{r.season}</td>
          {!major && <td>{levelFor(r.sportId)?.label ?? '—'}</td>}
          <td>{r.team || '—'}</td>
          <td>{orDash(r.age)}</td>
          {COLS.map(([key]) => <td>{orDash(r[key])}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
