---
// A player photo, down the fallback chain in lib/identity/headshot.js: the
// studio shot, then the MiLB shot, then his initials. The swap runs on the
// image's error event, so a missing photo never shows a broken icon.
import { headshotChain, headshotOnError, initialsOf } from '../lib/identity/headshot.js'

const { player } = Astro.props
const [first, ...rest] = headshotChain(player)
const initials = initialsOf(player?.name)
---
{first ? (
  <img
    class="headshot"
    src={first}
    alt={player.name}
    width="132"
    height="176"
    loading="lazy"
    data-fallbacks={rest.join(' ')}
    onerror={headshotOnError(initials)}
  />
) : (
  <div class="initials">{initials}</div>
)}
