{
  "name": "brewprospects",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview --port 4322",
    "data": "node scripts/data/gen-org.mjs && node scripts/data/fetch-pipeline.mjs && node scripts/data/gen-archive.mjs && node scripts/data/gen-prospect-history.mjs && node scripts/data/gen-mlb.mjs",
    "lint": "eslint . && node scripts/checks/run-all.mjs",
    "test": "node scripts/test.mjs",
    "e2e": "playwright test",
    "og-image": "node scripts/assets/og-image.mjs"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.9",
    "@astrojs/react": "^7.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0"
  },
